# Etapa 1: Construcción (Build)
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app

# Copiar la estructura completa del backend hacia el contenedor
COPY backend/pom.xml ./backend/
COPY backend/src ./backend/src

# Compilar apuntando directamente al pom.xml del backend (-f especifica el archivo de configuración)
RUN mvn clean package -f backend/pom.xml -DskipTests

# Verificación opcional del contenido del JAR
RUN echo "--- CONTENIDO DEL JAR ---" && jar tf /app/backend/target/torque-analyzer-1.0.0.jar

# Etapa 2: Imagen de ejecución (Liviana)
FROM eclipse-temurin:21-jre
WORKDIR /app

# Copiar el Fat JAR generado
COPY --from=build /app/backend/target/torque-analyzer-1.0.0.jar backend-api.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "backend-api.jar"]
