# Etapa 1: Construcción
FROM node:20-alpine AS builder
WORKDIR /app

# Copia los package.json desde la carpeta frontend
COPY frontend/package*.json ./
RUN npm install

# Copia todo el contenido de la carpeta frontend
COPY frontend/ ./
RUN npm run build 

# Etapa 2: Servidor Web
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html 
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
